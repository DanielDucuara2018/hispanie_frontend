# Hispanie Frontend - Environment Variables Template
# Copy this file to .env and fill in your values

# API Configuration
# For local development with Docker
REACT_APP_HISPANIE_API_URL=http://localhost:3201

# For local development with custom domains (requires start-dev.sh)
# REACT_APP_HISPANIE_API_URL=https://api.hispanie.local

# For production, use:
# REACT_APP_HISPANIE_API_URL=https://api.hispanie.com

# Optional: Enable Redux DevTools in development
REACT_APP_ENABLE_REDUX_DEVTOOLS=true

# Webpack Dev Server Configuration (for Docker development)
DANGEROUSLY_DISABLE_HOST_CHECK=true
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3202
